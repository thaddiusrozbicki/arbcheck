# Copy this to .env and fill it in. Never commit .env.
# The REST poller needs nothing here. The endpoints it polls are public.

# Kalshi WebSocket feed (python -m poller.ws_run). Use a read-only API key.
# KALSHI_ENV is prod (real prices) or demo (demo-api.kalshi.co, fake prices for testing).
# Keep the private key file outside the repo, e.g. ~/.kalshi/arbcheck-prod.pem
KALSHI_ENV=prod
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# LLM rule checker (scripts/check_rules.py reads LLM_API_KEY or OPENAI_API_KEY, plus OPENAI_MODEL)
LLM_API_KEY=
OPENAI_MODEL=
