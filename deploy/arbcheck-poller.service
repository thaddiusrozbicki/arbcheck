# Keeps the poller running on the server and restarts it after crashes or reboots.
#   sudo cp deploy/arbcheck-poller.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now arbcheck-poller
[Unit]
Description=ArbCheck poller
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/arbcheck
ExecStart=/home/ubuntu/arbcheck/.venv/bin/python -m poller.run --interval 10
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
